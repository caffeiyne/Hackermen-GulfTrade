FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for asyncpg
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY simulator/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy simulator application code
COPY simulator/ .

# Copy database scripts (schema, seeds, disruptions, generate_sales.py)
COPY db/ /app/db/

# Expose port — Railway sets $PORT, we pass it to uvicorn
EXPOSE 8000

# Install psql for applying schema files
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && \
    rm -rf /var/lib/apt/lists/*

# Start command:
# 1. Apply schema + seeds + disruptions (always — uses IF NOT EXISTS / ON CONFLICT)
# 2. If RUN_SEED=1, generate 90 days of sales data
# 3. Start uvicorn on the assigned port
# Note: sslmode=require is appended if not already present (Render Postgres requires SSL)
CMD sh -c "DB_URL=\"${DATABASE_URL}\\\&sslmode=require\" && \
           case \"$DATABASE_URL\" in *sslmode=*) DB_URL=\"$DATABASE_URL\";; esac && \
           psql \"$DB_URL\" -f /app/db/schema.sql && \
           psql \"$DB_URL\" -f /app/db/seeds.sql && \
           psql \"$DB_URL\" -f /app/db/disruptions.sql && \
           if [ \"$RUN_SEED\" = \"1\" ]; then python /app/db/generate_sales.py --db-url \"$DB_URL\"; fi && \
           uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
