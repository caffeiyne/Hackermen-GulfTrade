# ============================================================================
# Environment Variables — Tradeling Hackathon
# Copy this file to .env in each service folder and fill in values.
# ============================================================================

# --- Database (PostgreSQL) ---
# Local dev (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradling
# Supabase example (use DIRECT connection, NOT pooled — LISTEN/NOTIFY needs it):
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres
# Neon example (append ?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- FastAPI Simulator ---
# Set in simulator/.env
API_TITLE=Tradeling Inventory Intelligence Simulator
CORS_ORIGINS=["http://localhost:3000"]

# --- Next.js Dashboard ---
# Set in dashboard/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# ============================================================================
# RAILWAY DEPLOYMENT
# ============================================================================
#
# Create 3 services on Railway:
#
# 1. PostgreSQL (Railway managed — gives you DATABASE_URL automatically)
#
# 2. Simulator service:
#    - Source: GitHub repo, Dockerfile: Dockerfile.simulator
#    - Env vars:
#      DATABASE_URL=<from Railway Postgres>
#      CORS_ORIGINS=https://your-dashboard.up.railway.app
#      RUN_SEED=1   (set this ONCE on first deploy, then remove to avoid re-seeding)
#
# 3. Dashboard service:
#    - Source: GitHub repo, Dockerfile: Dockerfile.dashboard
#    - Env vars:
#      NEXT_PUBLIC_API_URL=https://your-simulator.up.railway.app
#      NEXT_PUBLIC_WS_URL=wss://your-simulator.up.railway.app/ws/live
#
# After first deploy with RUN_SEED=1, verify the DB has data:
#   - Visit https://your-simulator.up.railway.app/api/skus (should return JSON)
#   - Then remove RUN_SEED=1 and redeploy the simulator
#
# Dashboard URL → generate QR code → put on closing slide
