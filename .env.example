# ============================================================================
# Environment Variables — Tradeling Hackathon
# Copy this file to .env in each service folder and fill in values.
# ============================================================================

# --- Database (PostgreSQL) ---
# Local dev (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradling
# Supabase example (use DIRECT connection, NOT pooled — LISTEN/NOTIFY needs it):
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres
# Neon example (append ?sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- FastAPI Simulator ---
# Set in simulator/.env
API_TITLE=Tradeling Inventory Intelligence Simulator
CORS_ORIGINS=["http://localhost:3000"]

# --- Next.js Dashboard ---
# Set in dashboard/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# --- Production URLs (when deployed) ---
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# NEXT_PUBLIC_WS_URL=wss://your-backend.railway.app/ws/live
